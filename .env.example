# ---------------------------------------------------------------------------
# Local environment (copy to `.env.local` and fill in during Phase 2)
# Never commit real credentials or service-account keys.
# ---------------------------------------------------------------------------

# Firebase **web** configuration. These values are public by design (they ship
# in the browser bundle), but access is only safe because of Firestore/Storage
# Security Rules and server-side validation. Web config is NOT a secret and
# NOT a substitute for security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base path for GitHub Pages. Leave empty for automatic detection:
#   project site  -> "/<repository-name>/"
#   custom domain -> "/"
# VITE_BASE_PATH=/

# Frontend-only sample data (clearly labelled in the UI, never used when
# Firebase is configured). Enable to preview the screens before Phase 2.
VITE_ENABLE_DEMO_PREVIEW=false
