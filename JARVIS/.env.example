# ---------------------------------------------------------------------------
# JARVIS - optional environment variables.
# Copy this file to ".env" in the same folder. ".env" is ignored by Git.
# Nothing here is required for the default (Google Web Speech + openWakeWord)
# setup. Do NOT commit real keys.
# ---------------------------------------------------------------------------

# Gemini API key. Required for conversation, task planning and page summary.
# Get one at https://aistudio.google.com/app/apikey - it is free for personal use.
# JARVIS also reads this from %USERPROFILE%\.jarvis\gemini_key.txt (created by
# the first-run wizard or Settings). Never commit a real key.
GEMINI_API_KEY=

# Optional. Google Web Speech API works without a key for low-volume personal
# use, but that unauthenticated endpoint is not guaranteed. If you have a key,
# put it here and speech.google_api_key_env will pick it up.
GOOGLE_SPEECH_API_KEY=

# Absolute path to a directory where openWakeWord keeps its .onnx models.
# Leave empty to use the library default (~/.cache/openwakeword or its package
# models folder). Run `python -m jarvis_bootstrap` style one-liner from README
# (openwakeword.utils.download_models) on the first run.
OPENWAKEWORD_MODEL_DIR=

# Local Whisper model cache (only used with speech.backend = "whisper").
HF_HOME=

# Absolute path to an extracted Vosk model (only used with backend = "vosk").
# e.g. C:\models\vosk-model-small-en-in-0.4
VOSK_MODEL_PATH=

# Override the config file location (otherwise JARVIS/config.json is used).
JARVIS_CONFIG=

# DEBUG, INFO, WARNING or ERROR.
JARVIS_LOG_LEVEL=INFO
